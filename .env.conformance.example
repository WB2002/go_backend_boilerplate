# ==============================================================================
# Conformance Test Environment Profile (.env.conformance.example)
#
# Pinned configuration profile for running the language-agnostic conformance
# test suite against this Go backend boilerplate.
#
# NOTE: Required secrets and infrastructure endpoints (JWT_PRIVATE_KEY,
# JWT_PUBLIC_KEY, COOKIE_SECRET, POSTGRES_*, REDIS_*, MONGO_URI) must be
# supplied via your local environment or CI runner.
# ==============================================================================

APP_NAME=go_backend_boilerplate
APP_ENV=test
PORT=8080
POSTGRES_SSLMODE=disable
JWT_ACCESS_TOKEN_TTL_SEC=900
JWT_REFRESH_TOKEN_TTL_SEC=604800
ARGON2_MAX_CONCURRENT=4
ARGON2_QUEUE_DEPTH=32
ARGON2_QUEUE_TIMEOUT_MS=10000
RATE_LIMIT_DEFAULT_LIMIT=100000
RATE_LIMIT_DEFAULT_WINDOW_SEC=60
OVERLOAD_MAX_IN_FLIGHT=1000
OVERLOAD_PRIORITY_SHEDDING_ENABLED=true
INBOUND_LOAD_LEVEL_MAX_QUEUE=64
INBOUND_LOAD_LEVEL_MAX_WAIT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MAX_MS=30000
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_MESSAGES_PER_MINUTE=120
GQL_MAX_DEPTH=10
GQL_MAX_COMPLEXITY=50
GQL_USER_BUDGET=1000
HEALTH_CHECK_CACHE_TTL_MS=2000
FEATURE_FLAG_RECONCILE_MS=60000
