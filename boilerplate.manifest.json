{
  "name": "go-backend-boilerplate",
  "language": "go",
  "openapiUrl": "/swagger/doc.json",
  "capabilities": {
    "health": {
      "method": "GET",
      "path": "/health/live"
    },
    "auth": {
      "register": {
        "method": "POST",
        "path": "/account/register",
        "emailField": "email",
        "passwordField": "password"
      },
      "login": {
        "method": "POST",
        "path": "/account/login",
        "emailField": "email",
        "passwordField": "password",
        "tokenPath": "accessToken",
        "refreshPath": "refreshToken"
      },
      "me": {
        "method": "GET",
        "path": "/account/me",
        "userIdPath": "id"
      },
      "refresh": {
        "method": "POST",
        "path": "/account/refresh"
      }
    },
    "websockets": {
      "enabled": true,
      "path": "/realtime"
    }
  },
  "architecture": {
    "publicRoutes": [
      "/health",
      "/health/live",
      "/health/ready",
      "/swagger/*",
      "/playground",
      "/graphiql",
      "/graphql",
      "/account/register",
      "/account/login",
      "/account/refresh",
      "/account/forgot-password",
      "/account/reset-password"
    ],
    "requireAuthOnNonPublic": true
  }
}
