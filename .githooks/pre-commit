#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/bin:$PATH"

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

STAGED_GO_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)"
if [[ -n "${STAGED_GO_FILES}" ]]; then
  UNFORMATTED="$(printf '%s\n' "${STAGED_GO_FILES}" | xargs gofmt -l)"
  if [[ -n "${UNFORMATTED}" ]]; then
    echo "The following Go files are not formatted (run gofmt -w):" >&2
    printf '%s\n' "${UNFORMATTED}" >&2
    exit 1
  fi

  if command -v golangci-lint >/dev/null 2>&1; then
    lint_out="$(mktemp)"
    if ! golangci-lint run ./... 2>"${lint_out}"; then
      if grep -q "used to build golangci-lint is lower than the targeted Go version" "${lint_out}"; then
        echo "Warning: skipping golangci-lint (binary built with older Go than go.mod); falling back to go vet." >&2
        rm -f "${lint_out}"
        go vet ./...
      else
        cat "${lint_out}" >&2
        rm -f "${lint_out}"
        exit 1
      fi
    else
      rm -f "${lint_out}"
    fi
  else
    go vet ./...
  fi
fi

./scripts/gitleaks-pre-commit.sh
